<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableToolbox.ComparePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:TableToolbox"
    Background="Transparent">

    <Grid Padding="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="表格对比" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="勾选要对比的表格，指定关键列后比对差异。基准表排在最前。" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="12">
                <TextBlock Text="参与对比的表格（按顺序，第一张为基准）" FontSize="13" FontWeight="SemiBold"/>
                <ListView x:Name="LstTables" SelectionMode="Multiple" Height="96" BorderThickness="1"
                          BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="6"
                          SelectionChanged="LstTables_SelectionChanged"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="关键列（列名，多列用逗号）" VerticalAlignment="Center" FontSize="13"/>
                    <TextBox x:Name="TxtKeys" PlaceholderText="例如：编号" Width="220" TextChanged="Cfg_Changed"/>
                    <TextBlock Text="值列（留空=全部）" VerticalAlignment="Center" FontSize="13" Margin="12,0,0,0"/>
                    <TextBox x:Name="TxtValues" PlaceholderText="例如：金额,状态" Width="220" TextChanged="Cfg_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="BtnCompare" Content="开始对比" Click="BtnCompare_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"/>
                    <TextBlock x:Name="TxtHint" Text="请先在「表格识别」页加入至少两张表" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" MinHeight="200">
            <Grid>
                <TextBlock x:Name="EmptyHint" Text="对比结果" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ScrollViewer x:Name="ResultScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ResultRows" Spacing="2" Margin="8"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
            <TextBlock x:Name="TxtStats" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <Button x:Name="BtnToDerive" Content="用此结果生成派生表 →" Click="BtnToDerive_Click" IsEnabled="False" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</Page>
