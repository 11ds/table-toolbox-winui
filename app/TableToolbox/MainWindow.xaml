<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TableToolbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:TableToolbox"
    Title="表格工具箱">

    <Grid x:Name="RootGrid" RequestedTheme="Light" Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：只是外观，不含任何业务逻辑 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="#FFFFFF">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0"
                        Spacing="10">
                <Border Width="22" Height="22" CornerRadius="6" Background="#2F6BFF">
                    <TextBlock Text="表"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="表格工具箱"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1F2328"
                           VerticalAlignment="Center"/>
                <Border Width="1" Height="12" Background="#E3E6EA" VerticalAlignment="Center"/>
                <TextBlock Text="本地离线 · 数据不出电脑"
                           FontSize="11"
                           Foreground="#8A9099"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 标题栏下细分隔线 -->
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="#EDEFF2"/>

        <!-- 网页内容区：原页面原样承载 -->
        <Grid Grid.Row="1">
            <muxc:WebView2 x:Name="Web" />

            <!-- 兜底：找不到网页文件时提示 -->
            <StackPanel x:Name="Fallback"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        MaxWidth="520">
                <Border Width="56" Height="56" CornerRadius="14" Background="#F1F4F9" HorizontalAlignment="Center">
                    <TextBlock Text="表"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#2F6BFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="页面没加载起来"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1F2328"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="FallbackText"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="13"
                           Foreground="#6B7280"/>
                <Button Content="用系统浏览器打开"
                        HorizontalAlignment="Center"
                        Click="OpenInBrowser_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
