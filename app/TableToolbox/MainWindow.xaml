<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TableToolbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:TableToolbox"
    Title="表格工具箱">

    <Grid Background="White">
        <!-- 原网页：所有功能、样式、逻辑一字未改 -->
        <muxc:WebView2 x:Name="Web" />

        <!-- 兜底：找不到网页文件时提示，并可改用浏览器打开 -->
        <StackPanel x:Name="Fallback"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    MaxWidth="520">
            <TextBlock Text="表格工具箱"
                       FontSize="24"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="FallbackText"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="14"
                       Foreground="#666666"/>
            <Button Content="用系统浏览器打开"
                    HorizontalAlignment="Center"
                    Click="OpenInBrowser_Click"/>
        </StackPanel>
    </Grid>
</Window>
