<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TableToolbox</RootNamespace>
    <AssemblyName>表格工具箱</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <AppxPackage>false</AppxPackage>
  </PropertyGroup>

  <!-- Unpackaged self-contained single-file EXE -->
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- 原网页编译进 exe 内部：只有一份来源，发布目录不会出现第二份可能过期的副本。
       运行时释放到 %LOCALAPPDATA%\TableToolbox\web\index.html 再加载。 -->
  <ItemGroup>
    <EmbeddedResource Include="web\index.html">
      <LogicalName>TableToolbox.web.index.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
